
<%- include("../partials/dashboard-layout-start") %>

<div class="page-header">
    <div>
        <span class="page-eyebrow">MATERIAL MANAGEMENT</span>
        <h1>Add Material</h1>
        <p>Record a construction material for <strong><%= project.name %></strong>.</p>
    </div>

    <div class="page-header-actions">
        <a href="/engineer/projects/<%= project._id %>/materials"
           class="secondary-button">
            Back to Inventory
        </a>
    </div>
</div>

<section class="dashboard-section">
    <div class="material-form-card">
        <% if (error) { %>
            <div class="material-form-error" role="alert">
                <%= error %>
            </div>
        <% } %>

        <form
            action="/engineer/projects/<%= project._id %>/materials"
            method="POST"
            class="material-form"
        >
            <div class="material-form-grid">
                <div class="material-form-field">
                    <label for="name">Material Name *</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        maxlength="100"
                        required
                        value="<%= formData.name || '' %>"
                        placeholder="e.g. Cement"
                    >
                </div>

                <div class="material-form-field">
                    <label for="unit">Unit *</label>
                    <input
                        type="text"
                        id="unit"
                        name="unit"
                        maxlength="30"
                        required
                        value="<%= formData.unit || '' %>"
                        placeholder="e.g. bags, kg, cubic metres"
                    >
                </div>

                <div class="material-form-field">
                    <label for="initialQuantity">Initial Quantity *</label>
                    <input
                        type="number"
                        id="initialQuantity"
                        name="initialQuantity"
                        min="0"
                        step="any"
                        required
                        value="<%= formData.initialQuantity ?? '' %>"
                    >
                </div>

                <div class="material-form-field">
                    <label for="minimumStockLevel">Minimum Stock Level *</label>
                    <input
                        type="number"
                        id="minimumStockLevel"
                        name="minimumStockLevel"
                        min="0"
                        step="any"
                        required
                        value="<%= formData.minimumStockLevel ?? '' %>"
                    >
                </div>

                <div class="material-form-field">
                    <label for="supplier">Supplier</label>
                    <input
                        type="text"
                        id="supplier"
                        name="supplier"
                        maxlength="150"
                        value="<%= formData.supplier || '' %>"
                        placeholder="Supplier or vendor name"
                    >
                </div>

                <div class="material-form-field">
                    <label for="cost">Material Cost *</label>
                    <input
                        type="number"
                        id="cost"
                        name="cost"
                        min="0"
                        step="any"
                        required
                        value="<%= formData.cost ?? '' %>"
                    >
                    <small>Enter the cost using your current accounting convention.</small>
                </div>
            </div>

            <div class="material-form-actions">
                <a
                    href="/engineer/projects/<%= project._id %>/materials"
                    class="secondary-button"
                >
                    Cancel
                </a>

                <button type="submit" class="page-action-button">
                    Save Material
                </button>
            </div>
        </form>
    </div>
</section>

<%- include("../partials/dashboard-layout-end") %>
