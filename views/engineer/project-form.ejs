<%- include("../partials/dashboard-layout-start") %>

<div class="page-header">

    <div>
        <h1>Create Project</h1>

        <p>
            Add a new construction project.
        </p>
    </div>

</div>


<section class="dashboard-section">

    <form
        action="/engineer/projects"
        method="POST"
        class="project-form"
    >

        <div class="form-grid">


            <!-- Project Name -->

            <div class="form-group">

                <label for="name">
                    Project Name
                </label>

                <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Enter project name"
                    required
                >

            </div>


            <!-- Client -->

            <div class="form-group">

                <label for="client">
                    Client
                </label>

                <select
                    id="client"
                    name="client"
                    required
                >

                    <option value="">
                        Select Client
                    </option>

                    <% clients.forEach(client => { %>

                        <option value="<%= client._id %>">
                            <%= client.name %> - <%= client.email %>
                        </option>

                    <% }) %>

                </select>

            </div>


            <!-- Site Location -->

            <div class="form-group form-group-full">

                <label for="siteLocation">
                    Site Location
                </label>

                <input
                    type="text"
                    id="siteLocation"
                    name="siteLocation"
                    placeholder="Enter construction site location"
                    required
                >

            </div>


            <!-- Project Type -->

            <div class="form-group">

                <label for="projectType">
                    Project Type
                </label>

                <input
                    type="text"
                    id="projectType"
                    name="projectType"
                    placeholder="Residential / Commercial"
                >

            </div>


            <!-- Budget -->

            <div class="form-group">

                <label for="budget">
                    Budget
                </label>

                <input
                    type="number"
                    id="budget"
                    name="budget"
                    min="0"
                    step="0.01"
                    placeholder="Enter project budget"
                    required
                >

            </div>


            <!-- Start Date -->

            <div class="form-group">

                <label for="startDate">
                    Start Date
                </label>

                <input
                    type="date"
                    id="startDate"
                    name="startDate"
                    required
                >

            </div>


            <!-- Expected Completion -->

            <div class="form-group">

                <label for="expectedCompletionDate">
                    Expected Completion Date
                </label>

                <input
                    type="date"
                    id="expectedCompletionDate"
                    name="expectedCompletionDate"
                    required
                >

            </div>


            <!-- Status -->

            <div class="form-group">

                <label for="status">
                    Status
                </label>

                <select
                    id="status"
                    name="status"
                >

                    <option value="PLANNING">
                        Planning
                    </option>

                    <option value="ACTIVE">
                        Active
                    </option>

                    <option value="ON_HOLD">
                        On Hold
                    </option>

                </select>

            </div>


            <!-- Description -->

            <div class="form-group form-group-full">

                <label for="description">
                    Description
                </label>

                <textarea
                    id="description"
                    name="description"
                    rows="5"
                    placeholder="Describe the construction project..."
                ></textarea>

            </div>


        </div>


        <div class="form-actions">

            <a
                href="/engineer/projects"
                class="secondary-button"
            >
                Cancel
            </a>

            <button
                type="submit"
                class="page-action-button"
            >
                Create Project
            </button>

        </div>

    </form>

</section>


<%- include("../partials/dashboard-layout-end") %>