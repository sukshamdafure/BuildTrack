<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BuildTrack | Construction Project Management</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <nav class="navbar" id="site-nav">
        <div class="logo">
            Build<span>Track</span>
        </div>

        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-links">
            Menu
        </button>

        <div class="nav-links" id="site-links">
            <a href="/">Home</a>
            <a href="#features">Features</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>
            <a href="/register">Register</a>
            <a href="/login" class="login-btn">Login</a>
        </div>
    </nav>

    <main id="main-content">
        <section class="hero">
            <div class="hero-content">
                <p class="eyebrow">Construction project management</p>
                <h1>
                    Manage. Monitor.<br>
                    <span>Build with confidence.</span>
                </h1>
                <p class="hero-description">
                    A centralized workspace for engineers, workers, and clients
                    to manage construction projects, track progress, and meet deadlines.
                </p>
                <div class="hero-buttons">
                    <a href="/login" class="btn btn-primary">Get started</a>
                    <a href="#features" class="btn btn-secondary">Explore features</a>
                </div>
            </div>
        </section>

        <section id="features" class="features">
            <div class="section-heading">
                <p class="eyebrow">Core features</p>
                <h2>Everything needed to monitor construction projects</h2>
            </div>

            <div class="feature-grid">
                <div class="feature-card">
                    <div class="feature-icon">✓</div>
                    <h3>Progress tracking</h3>
                    <p>Monitor construction progress using activity-level and weighted project progress.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">≡</div>
                    <h3>Task management</h3>
                    <p>Create construction activities, assign workers, and monitor deadlines.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">◇</div>
                    <h3>Resource management</h3>
                    <p>Track construction materials, labour, and project expenses.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">!</div>
                    <h3>Deadline monitoring</h3>
                    <p>Identify upcoming, at-risk, and delayed construction activities.</p>
                </div>
            </div>
        </section>

        <section id="about" class="about">
            <div>
                <p class="eyebrow">Built for construction</p>
                <h2>One platform for the entire project lifecycle.</h2>
            </div>
            <p>
                BuildTrack connects project engineers, construction workers, and clients
                through a centralized project management and monitoring system.
            </p>
        </section>

        <section id="contact" class="contact">
            <h2>BuildTrack</h2>
            <p>Construction Project Management System</p>
        </section>
    </main>

    <footer>
        <p>© 2026 BuildTrack — Academic Civil Engineering Project</p>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>
